     function getPathname(url) {
        return new URL(url, window.location.origin).pathname
            .replace(/\/$/, '')   // remove trailing slash
            .toLowerCase();      // normalize
    }

       var currentUrl = window.location.pathname;
    var matched = false; // flag to track if exact match was found

    // Step 1: Exact match
    $('.lp__page_navitem a').each(function() {
        var linkUrl = $(this).attr('href');
        if(linkUrl){
            linkUrl = getPathname(linkUrl);
        }

        if (linkUrl === currentUrl) {
            $(this).parent().addClass('active').siblings().removeClass('active');
            matched = true;
            return false; // stop looping after exact match
        }
    });

    // Step 2: Fallback to contains if no exact match
    if (!matched) {
        $('.lp__page_navitem a').each(function() {
            var linkUrl = $(this).attr('href');
            if(linkUrl){
            linkUrl = getPathname(linkUrl);
        }

